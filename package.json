{
  "name": "pi-output-navigation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keyboard navigation of Pi's fullscreen transcript",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hazlam/pi-output-navigation.git"
  },
  "bugs": { "url": "https://github.com/hazlam/pi-output-navigation/issues" },
  "keywords": ["pi-package", "pi-extension"],
